<Window x:Class="ChordPathFinder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ChordPathFinder.ViewModels"
        mc:Ignorable="d"
        Title="ChordPathFinder"
        Width="360"
        Height="800"
        MinWidth="360"
        MaxWidth="360"
        MinHeight="800"
        MaxHeight="800"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#3A4278"
        FontFamily="Roboto Serif">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="ChordTileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0C0052" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="Background" Value="#006A63" />
                    <Setter Property="Height" Value="64" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BottomButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#5B0059" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="3" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultPanelStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="8,12" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>

        <Style x:Key="DiscButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="74" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#2E2E2E" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="#1D3B7B" Margin="4,8,4,0" />
                            <Ellipse Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickNoteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#18538B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Width" Value="48" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="17" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F0F0F0" />

        <Grid Grid.Row="1">
            <Grid Visibility="{Binding IsBlocksScreen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="52" />
                </Grid.RowDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="24,20,24,8">
                    <ItemsControl ItemsSource="{Binding ChordTiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChordTileViewModel}">
                                <Button Style="{StaticResource ChordTileButtonStyle}" Margin="6,5" Command="{Binding ToggleCommand}">
                                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" MaxWidth="120">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Name}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Text" Value="{Binding ExpandedText}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="1" Margin="14,0,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Donation" Style="{StaticResource BottomButtonStyle}" Margin="1,0" Command="{Binding ShowDonationCommand}" />
                    <Button Grid.Column="1" Content="Find a way" Style="{StaticResource BottomButtonStyle}" Margin="1,0" Command="{Binding ShowFindWayCommand}" Background="#E500A0" />
                    <Button Grid.Column="2" Content="Clear" Style="{StaticResource BottomButtonStyle}" Margin="1,0" Command="{Binding ClearBlocksCommand}" />
                    <Button Grid.Column="3" Content="{Binding NotationToggleButtonText}" Style="{StaticResource BottomButtonStyle}" Margin="1,0" Command="{Binding ClassicCommand}" />
                </Grid>
            </Grid>

            <Grid Visibility="{Binding IsDonationScreen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="52" />
                </Grid.RowDefinitions>

                <ScrollViewer Margin="16,0,16,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel VerticalAlignment="Center" Margin="0,24,0,24">
                        <TextBlock Text="USDT TRC20" Foreground="White" FontSize="16" HorizontalAlignment="Center" />
                        <TextBlock Text="TPoFaJGu9JFXbUvwvBY4tU4sYE3AdoLDNmA" Foreground="White" FontSize="14" Margin="0,10,0,24" HorizontalAlignment="Center" />
                        <TextBlock Text="USDT Bep20" Foreground="White" FontSize="16" HorizontalAlignment="Center" />
                        <TextBlock Text="0x8d2dcc81c2011729b8f3094dd4ee652629092ebd" Foreground="White" FontSize="14" Margin="0,10,0,24" HorizontalAlignment="Center" />
                        <TextBlock Text="USDT TON" Foreground="White" FontSize="16" HorizontalAlignment="Center" />
                        <TextBlock Text="UQAJa5QD6iwSzY9uu-aP54Kj4gc75J2HdI4Xicuhu8ZHfHyu" Foreground="White" FontSize="14" Margin="0,10,0,24" HorizontalAlignment="Center" />
                        <TextBlock Text="USDC SOL" Foreground="White" FontSize="16" HorizontalAlignment="Center" />
                        <TextBlock Text="7s3pVGsDFaTuzS4FYaUUR959rauSo3UKh3i9FoZjK7ZU" Foreground="White" FontSize="14" Margin="0,10,0,24" HorizontalAlignment="Center" />
                        <TextBlock Text="USDC Bep20" Foreground="White" FontSize="16" HorizontalAlignment="Center" />
                        <TextBlock Text="0x8d2dcc81c2011729b8f3094dd4ee652629092ebd" Foreground="White" FontSize="14" Margin="0,10,0,24" HorizontalAlignment="Center" />
                        <TextBlock Text="USDC ARB" Foreground="White" FontSize="16" HorizontalAlignment="Center" />
                        <TextBlock Text="0x8d2dcc81c2011729b8f3094dd4ee652629092ebd" Foreground="White" FontSize="14" Margin="0,10,0,24" HorizontalAlignment="Center" />
                        <TextBlock Text="BTC" Foreground="White" FontSize="16" HorizontalAlignment="Center" />
                        <TextBlock Text="12tyRirrGv84agGG8Rubc17yYmBsT9e9dG" Foreground="White" FontSize="14" Margin="0,10,0,24" HorizontalAlignment="Center" />
                        <TextBlock Text="ETH ERC20" Foreground="White" FontSize="16" HorizontalAlignment="Center" />
                        <TextBlock Text="0x8d2dcc81c2011729b8f3094dd4ee652629092ebd" Foreground="White" FontSize="14" Margin="0,10,0,30" HorizontalAlignment="Center" />
                        <TextBlock Text="If you have any suggestions or bug reports," Foreground="White" FontSize="12" HorizontalAlignment="Center" />
                        <TextBlock Text="please write to me on Telegram: @why_magic" Foreground="White" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="1" Margin="14,0,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Donation" Style="{StaticResource BottomButtonStyle}" Margin="1,0" Background="#E500A0" Command="{Binding ShowDonationCommand}" />
                    <Button Grid.Column="1" Content="Back" Style="{StaticResource BottomButtonStyle}" Margin="1,0" Command="{Binding ShowBlocksCommand}" />
                    <Button Grid.Column="2" Content="Clear" Style="{StaticResource BottomButtonStyle}" Margin="1,0" Command="{Binding ClearFindWayCommand}" />
                    <Button Grid.Column="3" Content="{Binding NotationToggleButtonText}" Style="{StaticResource BottomButtonStyle}" Margin="1,0" Command="{Binding ClassicCommand}" />
                </Grid>
            </Grid>

            <Grid Visibility="{Binding IsFindWayScreen, Converter={StaticResource BoolToVisibilityConverter}}" Background="#010A6A">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="200" />
                </Grid.RowDefinitions>

                <Border Margin="16,14,16,8" Background="#010212" CornerRadius="3">
                    <Grid Margin="14,14,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource ResultPanelStyle}" Background="#04456B">
                            <Grid>
                                <TextBlock Text="{Binding CreativeDisplayPath}" Foreground="White" FontSize="12" VerticalAlignment="Bottom" TextAlignment="Center" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock Text="Creative" Foreground="White" FontSize="12" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource ResultPanelStyle}" Background="#1F0D9A">
                            <Grid>
                                <TextBlock Text="{Binding ShortestDisplayPath}" Foreground="White" FontSize="16" VerticalAlignment="Bottom" TextAlignment="Center" FontWeight="Bold" />
                                <TextBlock Text="Shortest" Foreground="White" FontSize="12" VerticalAlignment="Top" FontWeight="Bold" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource ResultPanelStyle}" Background="#450480">
                            <Grid>
                                <TextBlock Text="{Binding SmoothDisplayPath}" Foreground="White" FontSize="16" VerticalAlignment="Bottom" TextAlignment="Center" FontWeight="Bold" />
                                <TextBlock Text="Smooth" Foreground="White" FontSize="12" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Background="#6F56A5">
                    <Border Background="#6F56A5" CornerRadius="16,16,0,0" />

                    <Grid Visibility="{Binding IsPickerVisible, Converter={StaticResource BoolToVisibilityConverter}}" Margin="10,14,10,8">
                        <ItemsControl ItemsSource="{Binding AvailableChords}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Display}" Style="{StaticResource PickNoteButtonStyle}" Margin="4" Command="{Binding DataContext.SelectChordCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <Grid Margin="10,8,10,8">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPickerVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="54" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource BottomButtonStyle}" Content="Donation" Command="{Binding ShowDonationCommand}" Margin="18,0,18,0" />
                            <Button Grid.Column="2" Style="{StaticResource BottomButtonStyle}" Content="{Binding NotationToggleButtonText}" Command="{Binding ClassicCommand}" Margin="18,0,18,0" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource BottomButtonStyle}" Content="Blocks" Background="#E500A0" Command="{Binding ShowBlocksCommand}" Margin="18,0,18,0" />
                            <Button Grid.Column="1" Width="86" Height="62" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding GoCommand}" BorderBrush="#E5E500" BorderThickness="2" Foreground="White" FontSize="12" FontWeight="Bold">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="20" Background="#67004A" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="Go" FontSize="48" FontWeight="Bold" />
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource BottomButtonStyle}" Content="Clear" Command="{Binding ClearFindWayCommand}" Margin="18,0,18,0" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource DiscButtonStyle}" Command="{Binding OpenLeftPickerCommand}" HorizontalAlignment="Center">
                                <Border Background="#18538B" CornerRadius="20" Padding="12,6">
                                    <TextBlock Text="{Binding LeftChordLabel}" Foreground="White" FontWeight="Bold" FontSize="16" />
                                </Border>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource DiscButtonStyle}" Command="{Binding OpenRightPickerCommand}" HorizontalAlignment="Center">
                                <Border Background="#18538B" CornerRadius="20" Padding="12,6">
                                    <TextBlock Text="{Binding RightChordLabel}" Foreground="White" FontWeight="Bold" FontSize="16" />
                                </Border>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
